{
  "name": "recruitment-management-system",
  "version": "1.0.0",
  "description": "Full Stack Recruitment Management System",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd backend && npm run dev",
    "dev:client": "cd frontend && npm run dev",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "build": "cd frontend && npm run build",
    "start": "cd backend && npm start",
    "seed": "cd backend && npm run seed",
    "migrate": "cd backend && npm run migrate",
    "test": "cd backend && npm test",
    "app": "./app.sh",
    "app:start": "./start.sh",
    "app:stop": "./stop.sh",
    "app:status": "./app.sh status",
    "app:restart": "./app.sh restart",
    "app:logs": "./app.sh logs"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}
